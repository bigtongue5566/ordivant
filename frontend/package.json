{
  "name": "ordivant-frontend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "npm run build:suite",
    "build:suite": "tsc -b && vite build --configLoader runner --mode suite --outDir dist/suite",
    "build:work": "tsc -b && vite build --configLoader runner --mode work --outDir dist/work",
    "build:knowledge": "tsc -b && vite build --configLoader runner --mode knowledge --outDir dist/knowledge",
    "build:code": "tsc -b && vite build --configLoader runner --mode code --outDir dist/code",
    "typecheck": "tsc -b --pretty false",
    "test:agent-model-fields": "node ../scripts/agent-model-fields-test.mjs",
    "test:project-companions": "node ../scripts/project-companions-test.mjs",
    "test:access-tokens": "node ../scripts/access-tokens-test.mjs",
    "test:agent-presets": "node ../scripts/agent-presets-test.mjs",
    "test:agent-lifecycle": "node ../scripts/agent-lifecycle-test.mjs",
    "check:markdown": "node scripts/check-markdown.mjs",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --outDir dist/suite",
    "i18n:check": "node --test ../scripts/i18n-catalog-validation.test.mjs && node ../scripts/i18n-check.mjs",
    "test:navigation": "node ../scripts/navigation-test.mjs",
    "test:account-settings": "node ../scripts/account-settings-test.mjs",
    "test:sidebar": "node ../scripts/sidebar-test.mjs",
    "test:project-settings": "node ../scripts/project-settings-test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "antd": "^5.26.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
