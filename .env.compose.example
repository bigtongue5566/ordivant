# Optional Docker Compose settings. Copy this file to .env in the repository root.
# The default installation works without .env. Never put model keys or human passwords here.
COMPOSE_PROJECT_NAME=ordivant
ORDIVANT_WEB_PORT=8088
ORDIVANT_GITEA_PORT=3002
ORDIVANT_SECRETS_DIR=./.data/container-secrets
ORDIVANT_AUTH_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
ORDIVANT_AUTH_COOKIE_SECURE=false

# After initializing the execution service, keep it enabled on subsequent starts:
# COMPOSE_PROFILES=runtime

# For a fully initialized installation with Gitea and a sandbox, use a portable file separator:
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=compose.yaml,compose.sandbox.yaml
# COMPOSE_PROFILES=runtime,gitea,sandbox

# HTTPS reverse proxy example:
# ORDIVANT_AUTH_ORIGINS=https://ordivant.example.com
# ORDIVANT_AUTH_COOKIE_SECURE=true
# ORDIVANT_SSO_PUBLIC_ORIGIN=https://ordivant.example.com

# External MCP services use exact hostnames, separated by commas:
# ORDIVANT_TOOL_ALLOWED_HOSTS=tools.example.com

# Optional credentials: add -f compose.enterprise.yaml to docker compose commands.
# Place Identity files under .data/enterprise-secrets/identity and Code files under
# .data/enterprise-secrets/code. Each directory is mounted read-only only in its product.
# ORDIVANT_ENTERPRISE_SECRETS_DIR=./.data/enterprise-secrets
# ORDIVANT_SCIM_TOKEN_FILE=/run/ordivant-enterprise/scim-token
# ORDIVANT_SMTP_HOST=smtp.example.com
# ORDIVANT_SMTP_PORT=587
# ORDIVANT_SMTP_SENDER=ordivant@example.com
# ORDIVANT_SMTP_STARTTLS=true
# ORDIVANT_SMTP_USERNAME=
# ORDIVANT_SMTP_PASSWORD_FILE=/run/ordivant-enterprise/smtp-credential

# Optional Code deployment evidence config and token_file paths use Code's own mount.
# ORDIVANT_CODE_DEPLOYMENT_CONFIG_FILE=/run/ordivant-enterprise/deployment-providers.json
