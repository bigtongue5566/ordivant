# Copy to .env.local for local overrides; never commit real credentials.
ORDIVANT_MODE=development
# Default: repository-root .data/ordivant.db (SQLite quick start).
# PostgreSQL example: postgresql+psycopg://ordivant:YOUR_PASSWORD@127.0.0.1:5432/ordivant
# ORDIVANT_DATABASE_URL=
# ORDIVANT_DATA_DIR=
ORDIVANT_API_URL=http://127.0.0.1:8000
# Work-only existing VCS: project-scoped provider credentials and exact repository allowlist.
# ORDIVANT_VCS_CONFIG=C:/path/to/ignored/work-vcs.json
# HTTP is otherwise loopback-only. Compose explicitly permits its private Gitea service.
# ORDIVANT_VCS_HTTP_HOSTS=gitea
# Container overrides are read from the invoking shell; see docs/containers.md.
# ORDIVANT_WEB_PORT=8088
# ORDIVANT_GITEA_PORT=3002
# Independent product databases. Each defaults to its own SQLite file.
# ORDIVANT_KNOWLEDGE_DATABASE_URL=
# ORDIVANT_KNOWLEDGE_DATA_DIR=
ORDIVANT_KNOWLEDGE_API_URL=http://127.0.0.1:8010
# ORDIVANT_CODE_DATABASE_URL=
# ORDIVANT_CODE_DATA_DIR=
ORDIVANT_CODE_API_URL=http://127.0.0.1:8020
# Human account authentication. Runner/container helper generates the internal service secret.
# A fresh installation asks the user to create the first admin; no default human password.
# ORDIVANT_IDENTITY_DATABASE_URL=
# ORDIVANT_IDENTITY_DATA_DIR=
# ORDIVANT_IDENTITY_SERVICE_TOKEN_FILE=
# ORDIVANT_IDENTITY_ORG_ID=existing-local-org-id
# Container/runner selectors per product (their local organization IDs may differ).
# ORDIVANT_WORK_IDENTITY_ORG_ID=
# ORDIVANT_KNOWLEDGE_IDENTITY_ORG_ID=
# ORDIVANT_CODE_IDENTITY_ORG_ID=
# ORDIVANT_AUTH_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# HTTPS deployment requires true; false is allowed for loopback HTTP only.
# ORDIVANT_AUTH_COOKIE_SECURE=true
# Trust only exact reverse-proxy hosts/IPs that overwrite X-Real-IP. Compose defaults to web.
# ORDIVANT_AUTH_TRUSTED_PROXY_HOSTS=web
# Enterprise SSO is configured by an administrator in Account & Security.
# Preserve Identity DB plus identity_data/sso.key when rebuilding or backing up.
# ORDIVANT_SSO_PUBLIC_ORIGIN=https://ordivant.example.com
# ORDIVANT_SSO_ALLOWED_ENDPOINT_HOSTS=trusted-extra-jwks-or-token.example.com
# Private TLS issuer CA certificate mounted in identity_data (verification stays on).
# ORDIVANT_SSO_CA_BUNDLE=/data/enterprise-ca.pem
# Private HTTP and container backchannel routing require explicit trusted hosts.
# -WithIdentityBroker sets these for its own optional Keycloak service.
# ORDIVANT_SSO_HTTP_HOSTS=identity-broker
# ORDIVANT_SSO_BACKCHANNEL_OVERRIDES={"https://id.example.com":"http://identity-broker:8080"}
# Optional enterprise provisioning and encrypted SMTP outbox. Use secret files, never inline credentials.
# ORDIVANT_SCIM_TOKEN_FILE=/private/scim-token
# ORDIVANT_SMTP_HOST=smtp.example.com
# ORDIVANT_SMTP_PORT=587
# ORDIVANT_SMTP_SENDER=ordivant@example.com
# ORDIVANT_SMTP_STARTTLS=true
# ORDIVANT_SMTP_USERNAME=
# ORDIVANT_SMTP_PASSWORD_FILE=/private/smtp-credential
# ORDIVANT_BROKER_PORT=8093
# ORDIVANT_BROKER_PUBLIC_URL=https://id.example.com
# scripts/gitea_local.py generates an ignored local service configuration.
# scripts/dev.py automatically reads .data/gitea/connection.json if it exists.
# For another instance, use a private config file with url/token/webhook_secret.
# ORDIVANT_CODE_GITEA_CONFIG=
# ORDIVANT_CODE_GITEA_URL=
# ORDIVANT_CODE_GITEA_TOKEN=
# ORDIVANT_CODE_WEBHOOK_SECRET=
# Optional read-only deployment evidence; provider credentials stay in server-side files.
# ORDIVANT_CODE_DEPLOYMENT_CONFIG_FILE=/private/deployment-providers.json
ORDIVANT_RUNTIME_MODE=demo
# Configure provider connection/defaults in Work's administrator "模型連線" page.
# Agent create/edit may inherit or override those defaults; keys stay encrypted on Work.
# Configured dispatches use live models even when this process fallback is demo.
# ORDIVANT_RUNTIME_MODE=live requires a configured per-event model selection.
# ORDIVANT_RUNTIME_TOKEN=
